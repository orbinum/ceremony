/**
 * Ceremony coordinator (docs/COORDINATOR.md). Configuration reference:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceremony-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Reachable only on its own route: a workers.dev or preview URL would bypass Access and WAF rules.
  "workers_dev": false,
  "preview_urls": false,

  // One CeremonyDO per ceremony_id: the only writer of the queue, slot and records.
  "durable_objects": {
    "bindings": [{ "name": "CEREMONY", "class_name": "CeremonyDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CeremonyDO"] }],

  // PUBLIC: published artifacts (genesis, accepted contributions), immutable once written.
  // PRIVATE: uploads under verification (verify/…), never served to the public (SPEC §6.1).
  "r2_buckets": [
    { "binding": "PUBLIC", "bucket_name": "orbinum-ceremony-public-local" },
    { "binding": "PRIVATE", "bucket_name": "orbinum-ceremony-private-local" },
  ],

  // ENVIRONMENT is "production" unless a local run sets "local" (.dev.vars, tests): only then, and
  // only on a loopback host, the development identity header, /admin without Access and joining
  // without Turnstile are allowed. Each deployed environment (M7) sets its own CEREMONY_ID.
  // The contributor page (packages/client, built to dist): served by this Worker as static assets,
  // its own headers (CSP, no framing) in public/_headers. The routes below always reach the
  // Worker; any other unknown path gets the page (a single-page app).
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/artifacts/*", "/internal/*", "/admin/*"],
  },

  "vars": {
    "CEREMONY_ID": "local",
    "ENVIRONMENT": "production",
    // The GitHub OAuth app of this environment; its callback is <origin>/auth/github/callback.
    "GITHUB_CLIENT_ID": "",
    // Where verification jobs are dispatched (POST <url>/verify, HMAC); https (plain http only on
    // a loopback host); empty: no dispatch.
    "VERIFIER_URL": "",
    // Cloudflare Access application guarding /admin/* (https://<team>.cloudflareaccess.com and
    // its audience tag). A local deployment serves /admin without them; elsewhere they are required.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Who may use /admin besides passing Access: emails and service-token common names, comma
    // separated. Empty: nobody (outside a local run).
    "ACCESS_OPERATORS": "",
    // Seconds public reads (/api/status, /api/transcript, /api/receipt) are served from the edge
    // cache (0–60).
    "PUBLIC_CACHE_SECONDS": "5",
    // The Turnstile widget's site key, handed to the page by GET /api/config (public by design;
    // its secret is TURNSTILE_SECRET). Empty: nobody can join outside a local run.
    "TURNSTILE_SITE_KEY": "",
  },

  // Rate limits (60 s windows), per GitHub id except READ_LIMIT, AUTH_LIMIT and ARTIFACT_LIMIT
  // (per client network: an IPv4 address, an IPv6 /64). POLL_LIMIT covers the identified reads a
  // client polls (2 s polling of two of them fits). ARTIFACT_LIMIT leaves room for a whole mirror
  // (`download`) while bounding a download loop. Each namespace_id is unique per account.
  "ratelimits": [
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "NONCE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "ACTION_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    { "name": "POLL_LIMIT", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
    { "name": "ARTIFACT_LIMIT", "namespace_id": "1008", "simple": { "limit": 1000, "period": 60 } },
  ],

  // Set with `wrangler secret put` (deployed) or .dev.vars (local; see .dev.vars.example).
  "secrets": {
    "required": ["SESSION_KEY", "GITHUB_CLIENT_SECRET", "VERIFIER_HMAC_KEY", "TURNSTILE_SECRET"],
  },

  // A deployment per network, each on its own subdomain with its own Durable Object, buckets,
  // rate-limit namespaces, GitHub OAuth app and secrets (`wrangler secret put … --env <name>`).
  // Bindings, vars and secrets are not inherited, so each environment lists all of them.
  "env": {
    // Worker `ceremony-coordinator-testnet`: the public rehearsal (SPEC §0.1).
    "testnet": {
      "routes": [{ "pattern": "ceremony.testnet.orbinum.network", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "CEREMONY", "class_name": "CeremonyDO" }],
      },
      "r2_buckets": [
        { "binding": "PUBLIC", "bucket_name": "orbinum-ceremony-testnet-public" },
        { "binding": "PRIVATE", "bucket_name": "orbinum-ceremony-testnet-private" },
      ],
      "vars": {
        "CEREMONY_ID": "orbinum-testnet-rehearsal-1",
        "ENVIRONMENT": "testnet",
        "GITHUB_CLIENT_ID": "Ov23li2sBLCtW89N1Mth",
        "VERIFIER_URL": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ACCESS_OPERATORS": "",
        "PUBLIC_CACHE_SECONDS": "5",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFkHdw3xFCBHaCin",
      },
      "ratelimits": [
        { "name": "JOIN_LIMIT", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "NONCE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
        { "name": "UPLOAD_LIMIT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "ACTION_LIMIT", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
        { "name": "READ_LIMIT", "namespace_id": "2005", "simple": { "limit": 120, "period": 60 } },
        { "name": "POLL_LIMIT", "namespace_id": "2006", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMIT", "namespace_id": "2007", "simple": { "limit": 30, "period": 60 } },
        {
          "name": "ARTIFACT_LIMIT",
          "namespace_id": "2008",
          "simple": { "limit": 1000, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "SESSION_KEY",
          "GITHUB_CLIENT_SECRET",
          "VERIFIER_HMAC_KEY",
          "TURNSTILE_SECRET",
        ],
      },
    },
    // Worker `ceremony-coordinator-mainnet`: the ceremony whose keys ship (ENVIRONMENT
    // "production" freezes only a mainnet announcement). Empty values are filled before its first
    // deploy, which is by hand: a new Worker has no secrets yet (README).
    "mainnet": {
      "routes": [{ "pattern": "ceremony.orbinum.network", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "CEREMONY", "class_name": "CeremonyDO" }],
      },
      "r2_buckets": [
        { "binding": "PUBLIC", "bucket_name": "orbinum-ceremony-mainnet-public" },
        { "binding": "PRIVATE", "bucket_name": "orbinum-ceremony-mainnet-private" },
      ],
      "vars": {
        // Must equal the mainnet announcement's ceremony_id.
        "CEREMONY_ID": "orbinum-mainnet-1",
        "ENVIRONMENT": "production",
        "GITHUB_CLIENT_ID": "",
        "VERIFIER_URL": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ACCESS_OPERATORS": "",
        "PUBLIC_CACHE_SECONDS": "5",
        "TURNSTILE_SITE_KEY": "",
      },
      "ratelimits": [
        { "name": "JOIN_LIMIT", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
        { "name": "NONCE_LIMIT", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } },
        { "name": "UPLOAD_LIMIT", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
        { "name": "ACTION_LIMIT", "namespace_id": "3004", "simple": { "limit": 60, "period": 60 } },
        { "name": "READ_LIMIT", "namespace_id": "3005", "simple": { "limit": 120, "period": 60 } },
        { "name": "POLL_LIMIT", "namespace_id": "3006", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMIT", "namespace_id": "3007", "simple": { "limit": 30, "period": 60 } },
        {
          "name": "ARTIFACT_LIMIT",
          "namespace_id": "3008",
          "simple": { "limit": 1000, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "SESSION_KEY",
          "GITHUB_CLIENT_SECRET",
          "VERIFIER_HMAC_KEY",
          "TURNSTILE_SECRET",
        ],
      },
    },
  },
}
