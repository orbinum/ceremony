{
  "name": "@orbinum-ceremony/coordinator",
  "version": "0.5.0",
  "private": true,
  "description": "Ceremony coordinator: Cloudflare Worker + Durable Object (queue, uploads, transcript)",
  "author": "Orbinum Technologies <contact@orbinum.net>",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @orbinum-ceremony/client build && wrangler dev",
    "deploy": "pnpm --filter @orbinum-ceremony/client build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orbinum-ceremony/core": "workspace:*",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "ethers": "6.17.0",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@polkadot/keyring": "14.0.3",
    "wrangler": "4.165.0"
  }
}
