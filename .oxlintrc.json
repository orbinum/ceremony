{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./scripts/oxlint-ceremony-plugin.mjs"],
  "plugins": ["typescript", "unicorn", "import", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@orbinum-ceremony/*/*", "!@orbinum-ceremony/core/snarkjs-child"],
            "message": "Import other packages only through their barrel (package root)."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "artifacts",
    "target",
    "**/worker-configuration.d.ts"
  ],
  "overrides": [
